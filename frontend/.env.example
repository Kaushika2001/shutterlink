# Local dev — API on port 5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Vercel fullstack deploy — leave NEXT_PUBLIC_API_URL empty to use same-origin /api
# NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Backend secrets (Vercel → Environment Variables, not NEXT_PUBLIC_*):
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET,
# CLOUDINARY_*, PAYMENT_SANDBOX_MODE, etc. — see backend/.env.example
