{
  "info": {
    "name": "ShutterLink API",
    "description": "ShutterLink Photography Marketplace API\n\nBase URL: {{base_url}}/api\n\nAuthentication: JWT Bearer token (auto-set via Login/Register)\n\nStandard Response Format:\n{\n  \"success\": true|false,\n  \"data\": { ... },\n  \"error\": \"error message\",\n  \"message\": \"success message\"\n}",
