    { "key": "messageId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "availabilityScheduleId", "value": "", "type": "string" },
    { "key": "blockedDateId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" }
