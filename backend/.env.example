NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/shutterlink_db
JWT_SECRET=your-super-secret-key-at-least-32-characters-long-change-this
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Portfolio images — Option A: Cloudinary (recommended)
PORTFOLIO_STORAGE=cloudinary
# From https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=shutterlink_portfolio

# OnePay — https://developer.onepay.lk (Dashboard → App ID, tokens, hash salt)
ONEPAY_APP_ID=
ONEPAY_APP_TOKEN=
ONEPAY_HASH_SALT=
ONEPAY_HASH_TOKEN=

# HelaPay via PayHere IPG — https://www.payhere.lk (sandbox merchant)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Payment URLs (production: use public HTTPS URLs)
PAYMENT_WEBHOOK_BASE_URL=http://localhost:5000
PAYMENT_RETURN_URL=http://localhost:3000/dashboard/payments/return
