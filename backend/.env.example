# =============================================================================
# ShutterLink Backend — copy to backend/.env (or set in Railway/Render/Fly)
# =============================================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# --- Required (Supabase Dashboard → Project Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# --- Required in production ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
# Frontend URL(s) — comma-separated for www + apex, or Vercel preview + prod
CORS_ORIGIN=https://your-app.vercel.app
# Alias (optional): FRONTEND_URL=https://your-app.vercel.app
# Vercel preview deploys (*.vercel.app):
ALLOW_VERCEL_PREVIEW_ORIGINS=true

# --- Optional: direct Postgres (migrations scripts only) ---
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL=same_as_above

# --- Portfolio images ---
PORTFOLIO_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=shutterlink_portfolio

# --- Payments (production: HTTPS URLs, sandbox off for live charges) ---
PAYMENT_SANDBOX_MODE=false
PAYMENT_WEBHOOK_BASE_URL=https://api.yourdomain.com
PAYMENT_RETURN_URL=https://your-app.vercel.app/dashboard/payments/return
PAYMENT_WEBHOOK_SECRET=

# Stripe (test keys for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Local development defaults ---
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:3000
# PAYMENT_SANDBOX_MODE=true
# PAYMENT_WEBHOOK_BASE_URL=http://localhost:5000
# PAYMENT_RETURN_URL=http://localhost:3000/dashboard/payments/return
