{
  "name": "shutterlink-backend",
  "version": "1.0.0",
  "description": "ShutterLink Photography Marketplace Backend API",
  "main": "dist/app.js",
  "exports": {
    ".": "./dist/app.js",
    "./vercel": "./dist/vercel.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "build:vercel": "node scripts/build-vercel.mjs",
    "vercel-build": "npm run build && npm run build:vercel",
    "start": "node dist/server.js",
    "build:serverless": "tsc",
    "lint": "eslint src --ext .ts",
    "reset-test-data": "ts-node scripts/reset-test-data.ts",
    "db:messaging": "ts-node scripts/apply-messaging-migrations.ts",
    "check:env": "ts-node scripts/check-env.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.22.4",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
