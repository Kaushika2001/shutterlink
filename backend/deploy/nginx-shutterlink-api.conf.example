# Nginx site for ShutterLink API
# 1. Copy: sudo cp deploy/nginx-shutterlink-api.conf.example /etc/nginx/sites-available/shutterlink-api
# 2. Edit server_name to your API subdomain
# 3. sudo ln -s /etc/nginx/sites-available/shutterlink-api /etc/nginx/sites-enabled/
# 4. sudo nginx -t && sudo systemctl reload nginx
# 5. sudo certbot --nginx -d api.yourdomain.com

server {
    listen 80;
    listen [::]:80;
    server_name api.yourdomain.com;

    # Certbot will add SSL server block after: certbot --nginx -d api.yourdomain.com

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Portfolio uploads / Stripe webhooks
        client_max_body_size 50M;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
    }
}
