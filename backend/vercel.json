{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 5,
      "memory": 256
    }
  }
}
