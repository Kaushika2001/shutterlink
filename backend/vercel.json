{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build && npm run build:vercel",
  "redirects": [
    {
      "source": "/",
      "destination": "/api/health",
      "permanent": false
    }
  ],
  "functions": {
    "api/health.js": {
      "maxDuration": 5,
      "memory": 128
    },
    "api/[[...path]].js": {
      "maxDuration": 10,
      "memory": 1024
    }
  }
}
